<div class="card @CardClass">
  @if (AllowToggle)
  {
    <div class="card-header @CardHeaderClass" role="button" @onclick="Toggle">
      <i class="@BtnClass">&nbsp;</i>
      @HeaderContent
    </div>

  }
  else
  {
    <div class="card-header @CardHeaderClass">
      @HeaderContent
    </div>
  }

  <div class="card-body-grid @(_showCardBody ? "show" : "")" @ontransitionend="OnTransitionEnd">
    <div>
      @if (_renderCardBody)
      {
        <div class="card-body">
          @ChildContent
        </div>
        @if (FooterContent != null)
        {
          <div class="card-footer">
            @FooterContent
          </div>
        }
      }
    </div>
  </div>
</div>
@code {
  [Parameter]
  public RenderFragment HeaderContent { get; set; } = default!;

  [Parameter]
  public RenderFragment ChildContent { get; set; } = default!;

  [Parameter]
  public RenderFragment? FooterContent { get; set; }

  [Parameter] public bool ShowCardBody { get; set; } = true;
  [Parameter] public bool AllowToggle { get; set; } = false;

  public string BtnClass => _showCardBody ? "fa-fw fa fa-chevron-down" : "fa-fw fa fa-chevron-right";
  [Parameter] public string CardClass { get; set; } = "mb-2";
  [Parameter] public string CardHeaderClass { get; set; } = "";

  public bool _showCardBody { get; set; }
  private bool _renderCardBody { get; set; }


  protected override void OnInitialized()
  {
    _showCardBody = ShowCardBody;
    _renderCardBody = ShowCardBody;
  }

  public void Toggle()
  {
    if (_showCardBody)
    {
      // Start hide animation; keep rendered until transition finishes
      _showCardBody = false;
    }
    else
    {
      // Ensure element is rendered, then start show animation
      _renderCardBody = true;
      _showCardBody = true;
    }
  }

  private void OnTransitionEnd()
  {
    // When hide animation finishes, remove element from DOM
    if (!_showCardBody && _renderCardBody)
    {
      _renderCardBody = false;
      InvokeAsync(StateHasChanged);
    }
  }
}
