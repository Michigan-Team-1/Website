<div class="modal-backdrop fade show"></div>
<div class="modal fade show d-block modal-lg" style="pointer-events: none;" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <div class="col"><h5 class="modal-title">@BlazoredModal.Title</h5></div>
        <div class="col"><UnsavedChangesNotifcation Value="dataUpdated" /></div>
        <button type="button" class="btn-close" aria-label="Close" @onclick="(async () => await BlazoredModal.CancelAsync())">
        </button>
      </div>
      <EditForm EditContext="_editContext" OnValidSubmit="Save">
        <div class="modal-body">
          <Blazored.FluentValidation.FluentValidationValidator />
          <ValidationSummary />
          <div class="form-horizontal">
            <EditText @bind-Value="Dto.Name" PropertyInfo="PropertyReflections.GetEventDtoProperty(nameof(Dto.Name))" ValidationFor="(() => Dto.Name)" />
            <EditDate @bind-Value="Dto.EventDate" PropertyInfo="PropertyReflections.GetEventDtoProperty(nameof(Dto.EventDate))" ValidationFor="(() => Dto.EventDate)" />
            <EditDate @bind-Value="Dto.EventAlternateDate" PropertyInfo="PropertyReflections.GetEventDtoProperty(nameof(Dto.EventAlternateDate))" ValidationFor="(() => Dto.EventAlternateDate)" />
            @foreach (var item in Dto.EventLocations!)
            {
              <EditSelect @bind-Value="item.LocationId" PropertyInfo="PropertyReflections.GetEventDtoProperty(nameof(Dto.EventLocations))"
                          ValidationFor="(() => item.LocationId)" HideLabel=true DivContainerCss="mb-2 row">
                <option value="">Select...</option>
                @foreach (var l in Locations)
                {
                  <option selected=@(item.LocationId == l.Value) value="@(l.Value)">@l.Text</option>
                }
              </EditSelect>
            }

            <EditCheckbox @bind-Value="@Dto.IsActive" PropertyInfo="PropertyReflections.GetEventDtoProperty(nameof(Dto.IsActive))" />

            <AuditFields Dto="Dto.AuditFieldsDto" LayoutHorizontal=true />
          </div>
        </div>
        <div class="modal-footer">
          <div class="col"><UnsavedChangesNotifcation Value="dataUpdated" /></div>
          <div class="col text-end"><ModalDefaultFooterButtons OnCancel="BlazoredModal.CancelAsync" /></div>
        </div>
      </EditForm>
    </div>
  </div>
</div>

@inject IModalService ModalService
@inject AuthorizedClient client
@code {
  [CascadingParameter]
  private BlazoredModalInstance BlazoredModal { get; set; } = default!;

  [Parameter, EditorRequired]
  public EventDto DtoOriginal { get; set; } = default!;

  [Parameter, EditorRequired]
  public List<SelectOptionDto<int>> Locations { get; set; } = default!;

  private EventDto Dto { get; set; } = default!;

  private EditContext _editContext = default!;

  private bool dataUpdated
  {
    get
    {
      return !Dto.Equals(DtoOriginal);
    }
  }

  protected override void OnInitialized()
  {
    Dto = DtoOriginal.SerializeJson().DeserializeJson<EventDto>()!;
    _editContext = new EditContext(Dto);
  }

  async Task Save()
  {
    Dto.IsUpdated = dataUpdated;
    if (Dto.IsUpdated)
    {
      var data = await client.SaveLocation(Dto);
      if (data != null)
        await BlazoredModal.CloseAsync(ModalResult.Ok(data));
    }
  }
}
