<div class="modal-backdrop fade show"></div>
<div class="modal fade show d-block modal-lg" style="pointer-events: none;" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <div class="col"><h5 class="modal-title">@BlazoredModal.Title</h5></div>
        <div class="col"><UnsavedChangesNotifcation Value="dataUpdated" /></div>
        <button type="button" class="btn-close" aria-label="Close" @onclick="(async () => await BlazoredModal.CancelAsync())">
        </button>
      </div>
      <EditForm EditContext="_editContext" OnValidSubmit="Save">
        <div class="modal-body">
          <Blazored.FluentValidation.FluentValidationValidator />
          <ValidationSummary />
          <div class="form-horizontal">
            <EditText @bind-Value="Dto.LocationName" PropertyInfo="PropertyReflections.GetLocationDtoProperty(nameof(Dto.LocationName))" ValidationFor="(() => Dto.LocationName)" />
            <EditText @bind-Value="Dto.LocationDescription" PropertyInfo="PropertyReflections.GetLocationDtoProperty(nameof(Dto.LocationDescription))" ValidationFor="(() => Dto.LocationDescription)" />
            <EditText @bind-Value="Dto.FAAWaiver" PropertyInfo="PropertyReflections.GetLocationDtoProperty(nameof(Dto.FAAWaiver))" ValidationFor="(() => Dto.FAAWaiver)" />
            <EditAddress Dto="Dto.AddressObj" PropertyInfo="PropertyReflections.GetLocationDtoProperty(nameof(Dto.AddressObj))"
                         ValidationFor="(() => Dto.AddressObj)" Countries="Countries" GoverningDistricts="GoverningDistricts" />
            <EditCheckbox @bind-Value="@Dto.IsActive" PropertyInfo="PropertyReflections.GetLocationDtoProperty(nameof(Dto.IsActive))" />

            <AuditFields Dto="Dto.AuditFieldsDto" LayoutHorizontal=true />
          </div>
        </div>
        <div class="modal-footer">
          <div class="col"><UnsavedChangesNotifcation Value="dataUpdated" /></div>
          <div class="col text-end"><ModalDefaultFooterButtons OnCancel="BlazoredModal.CancelAsync" /></div>
        </div>
      </EditForm>
    </div>
  </div>
</div>

@inject IModalService ModalService
@inject AuthorizedClient client
@code {
  [CascadingParameter]
  private BlazoredModalInstance BlazoredModal { get; set; } = default!;

  [Parameter, EditorRequired]
  public LocationDto DtoOriginal { get; set; } = default!;

  [Parameter, EditorRequired]
  public List<CountryDto> Countries { get; set; } = default!;

  [Parameter, EditorRequired]
  public List<GoverningDistrictDto> GoverningDistricts { get; set; } = default!;

  private LocationDto Dto { get; set; } = default!;

  private EditContext _editContext = default!;

  private bool dataUpdated
  {
    get
    {
      return !Dto.Equals(DtoOriginal);
    }
  }

  protected override void OnInitialized()
  {
    Dto = DtoOriginal.SerializeJson().DeserializeJson<LocationDto>()!;
    _editContext = new EditContext(Dto);
  }

  async Task Save()
  {
    Dto.IsUpdated = dataUpdated;
    if (Dto.IsUpdated)
    {
      var data = await client.SaveLocation(Dto);
      if (data != null)
        await BlazoredModal.CloseAsync(ModalResult.Ok(data));
    }
  }
}
