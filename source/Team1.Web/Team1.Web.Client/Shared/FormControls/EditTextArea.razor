@inherits InputBase<string>

<div class="@DivContainerCss">
  <label for="@($"{_predicate}{nameSuffix}")" class="col-form-label @LabelCss">
    <DefaultLabel Name=@(LabelTextOverride ?? PropertyReflections.GetLabelName(PropertyInfo)) IsRequired="@PropertyReflections.IsRequired(PropertyInfo)"></DefaultLabel>
    <InputUnsavedChangesNotifcation Value="@(OldValue.IfNullThenEmptyString() != CurrentValue.IfNullThenEmptyString())" />
  </label>
  <div class="col-sm">
    <textarea @bind="CurrentValue" @bind:event="oninput" onkeyup='this.style.height = "";this.style.height = this.scrollHeight + 3 + "px"' id="@($"{_predicate}{nameSuffix}")" class="form-control @CssClass"></textarea>
    @if (ValidationFor != null)
    {
      <ValidationMessage For="@ValidationFor" />
    }
  </div>
</div>

@code {
  [Parameter] public string LabelCss { get; set; } = "col-sm-3";

  [Parameter]
  public string DivContainerCss { get; set; } = "mb-3 row gx-2";

  [Parameter]
  public System.Reflection.PropertyInfo PropertyInfo { get; set; } = default!;

  [Parameter]
  public string? LabelTextOverride { get; set; }

  [Parameter]
  public System.Linq.Expressions.Expression<Func<string>>? ValidationFor { get; set; }

  private string? _predicate;

  private string nameSuffix = DateTime.UtcNow.Ticks.ToString();

  [Parameter]
  public string? OldValue { get; set; }

  protected override void OnInitialized()
  {
    if (OldValue == null)
      OldValue = Value;
    _predicate = PropertyInfo.Name;
  }

  protected override void OnParametersSet()
  {
  }

  protected override bool TryParseValueFromString(string value, out string result, out string? validationErrorMessage)
  {
    result = value;
    validationErrorMessage = null;
    return true;
  }
}
