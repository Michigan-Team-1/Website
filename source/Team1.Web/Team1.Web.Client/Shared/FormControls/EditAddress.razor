<div class="@DivContainerCss">
    @if(!HideLabel)
    {
    <label class="@LabelCss">
    <DefaultLabel Name=@PropertyReflections.GetLabelName(PropertyInfo) IsRequired="@PropertyReflections.IsRequired(PropertyInfo)"></DefaultLabel>
      <InputUnsavedChangesNotifcation Value="@(!DtoOriginal.Equals(Dto))" />
  </label>
  }
  <div class="col-sm">
    <EditSelect @bind-Value:get=Dto.CountryId @bind-Value:set="SetCountry" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.CountryId))"
                ValidationFor="(() => Dto.CountryId)" HideLabel=true DivContainerCss="mb-2 row">
      <option value="">Select...</option>
      @foreach (var item in Countries)
      {
        <option selected=@(Dto.CountryId == item.CountryId) value="@(item.CountryId)">@item.Name</option>
      }
    </EditSelect>
    <EditText @bind-Value="Dto.Address1" @bind-Value:after=DataChanged PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.Address1))" ValidationFor="(() => Dto.Address1)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    <EditText @bind-Value="Dto.Address2" @bind-Value:after=DataChanged PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.Address2))" ValidationFor="(() => Dto.Address2)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    @if (countryDto?.GoverningDistrictName == null)
    {
      <EditText @bind-Value="Dto.Address3" @bind-Value:after=DataChanged PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.Address3))" ValidationFor="(() => Dto.Address3)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    }
    <EditText @bind-Value="Dto.City" @bind-Value:after=DataChanged PropertyInfo ="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.City))" ValidationFor="(() => Dto.City)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    <div class="row">
      @if (!string.IsNullOrWhiteSpace(countryDto?.GoverningDistrictName))
      {
        <div class="col-6">
          <EditSelect @bind-Value="Dto.GoverningDistrictId" @bind-Value:after=DataChanged PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.GoverningDistrictId))"
                      ValidationFor="(() => Dto.GoverningDistrictId)" HideLabel=true DivContainerCss="mb-2 row">
            <option value="">Select...</option>
            @foreach (var item in GoverningDistricts.Where(w => w.CountryId == Dto.CountryId))
            {
              <option selected=@(Dto.GoverningDistrictId == item.GoverningDistrictId) value="@(item.GoverningDistrictId)">@item.Name</option>
            }
          </EditSelect>
        </div>
      }
      @if (countryDto?.PostalCodeMask != null)
      {
        <div class="col-6">
          <EditInputmask @bind-Value="Dto.PostalCode" @bind-Value:after=DataChanged PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.PostalCode))" Inputmask="@countryDto.PostalCodeMask"
                         ValidationFor="(() => Dto.PostalCode)" HideLabel=true DivContainerCss="mb-2 row" />
        </div>
      }
    </div>
    @if (ValidationFor != null)
    {
      <ValidationMessage For="@ValidationFor" />
    }
  </div>
</div>

@code {
  [Parameter] public string LabelCss { get; set; } = "col-form-label col-sm-3";

  [Parameter]
  public string DivContainerCss { get; set; } = "mb-3 row gx-2";

  [Parameter, EditorRequired]
  public System.Reflection.PropertyInfo PropertyInfo { get; set; } = default!;

  [Parameter, EditorRequired]
  public List<CountryDto> Countries { get; set; } = default!;

  [Parameter, EditorRequired]
  public List<GoverningDistrictDto> GoverningDistricts { get; set; } = default!;

  [Parameter]
  public System.Linq.Expressions.Expression<Func<AddressObjDto>>? ValidationFor { get; set; }

  [Parameter, EditorRequired]
  public AddressObjDto Dto { get; set; } = default!;

  [Parameter, EditorRequired]
  public EventCallback Updated { get; set; }

  [Parameter]
  public bool HideLabel { get; set; }

  private AddressObjDto DtoOriginal = default!;
  private CountryDto? countryDto;

  protected override async Task OnInitializedAsync()
  {
    DtoOriginal = Dto.SerializeJson().DeserializeJson<AddressObjDto>()!;
    await SetCountry(Dto.CountryId);
  }

  private async Task SetCountry(int? value)
  {
    Dto.CountryId = value;
    countryDto = Countries.FirstOrDefault(w => w.CountryId == value);
    Dto.GoverningDistrictName = countryDto?.GoverningDistrictName;
    Dto.PostalCodeMask = countryDto?.PostalCodeMask;
    await DataChanged();
  }

  private async Task DataChanged()
  {
    if (Updated.HasDelegate)
      await Updated.InvokeAsync();
  }
}
