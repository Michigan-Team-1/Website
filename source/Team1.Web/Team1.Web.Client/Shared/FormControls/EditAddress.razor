<div class="mb-3 row gx-2">
  <label class="col-form-label col-sm-3">
    <DefaultLabel Name=@PropertyReflections.GetLabelName(PropertyInfo) IsRequired="@PropertyReflections.IsRequired(PropertyInfo)"></DefaultLabel>
    <InputUnsavedChangesNotifcation Value="@(!DtoOriginal.Equals(Dto))" />
  </label>
  <div class="col-sm-9">
    <EditSelect @bind-Value:get=Dto.CountryId @bind-Value:set="SetCountry" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.CountryId))"
                ValidationFor="(() => Dto.CountryId)" HideLabel=true DivContainerCss="mb-2 row">
      <option value="">Select...</option>
      @foreach (var item in Countries)
      {
        <option selected=@(Dto.CountryId == item.CountryId) value="@(item.CountryId)">@item.Name</option>
      }
    </EditSelect>
    <EditText @bind-Value="Dto.Address1" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.Address1))" ValidationFor="(() => Dto.Address1)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    <EditText @bind-Value="Dto.Address2" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.Address2))" ValidationFor="(() => Dto.Address2)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    @if (countryDto?.GoverningDistrictName == null)
    {
      <EditText @bind-Value="Dto.Address3" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.Address3))" ValidationFor="(() => Dto.Address3)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    }
    <EditText @bind-Value="Dto.City" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.City))" ValidationFor="(() => Dto.City)" HideLabel=true DivContainerCss="mb-2 row" ShowPlaceHolder="true" />
    <div class="row">
      @if (!string.IsNullOrWhiteSpace(countryDto?.GoverningDistrictName))
      {
        <div class="col-6">
          <EditSelect @bind-Value="Dto.GoverningDistrictId" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.GoverningDistrictId))"
                      ValidationFor="(() => Dto.GoverningDistrictId)" HideLabel=true DivContainerCss="mb-2 row">
            <option value="">Select...</option>
            @foreach (var item in GoverningDistricts.Where(w => w.CountryId == Dto.CountryId))
            {
              <option selected=@(Dto.GoverningDistrictId == item.GoverningDistrictId) value="@(item.GoverningDistrictId)">@item.Name</option>
            }
          </EditSelect>
        </div>
      }
      @if (countryDto?.PostalCodeMask != null)
      {
        <div class="col-6">
          <EditInputmask @bind-Value="Dto.PostalCode" PropertyInfo="PropertyReflections.GetAddressObjDtoProperty(nameof(Dto.PostalCode))" Inputmask="@countryDto.PostalCodeMask"
                         ValidationFor="(() => Dto.PostalCode)" HideLabel=true DivContainerCss="mb-2 row" />
        </div>
      }
    </div>
    @if (ValidationFor != null)
    {
      <ValidationMessage For="@ValidationFor" />
    }
  </div>
</div>

@code {
  [Parameter, EditorRequired]
  public System.Reflection.PropertyInfo PropertyInfo { get; set; } = default!;

  [Parameter, EditorRequired]
  public List<CountryDto> Countries { get; set; }

  [Parameter, EditorRequired]
  public List<GoverningDistrictDto> GoverningDistricts { get; set; }

  [Parameter]
  public System.Linq.Expressions.Expression<Func<AddressObjDto>>? ValidationFor { get; set; }

  [Parameter, EditorRequired]
  public AddressObjDto Dto { get; set; }

  private AddressObjDto DtoOriginal;
  private CountryDto? countryDto;

  protected override void OnInitialized()
  {
    DtoOriginal = Dto;
    SetCountry(Dto.CountryId);
  }

  private void SetCountry(int? value)
  {
    Dto.CountryId = value;
    countryDto = Countries.FirstOrDefault(w => w.CountryId == value);
  }
}
