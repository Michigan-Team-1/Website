@page "/gallery"
@page "/gallery/{GalleryType}"
<PageTitle>@(isMyGallery ? "My Gallery" : "Gallery") - Michigan Team-1</PageTitle>

<div class="row mb-2">
  <div class="col-sm-6">
    <Team1.Web.Client.Shared.Helpers.PageHeader Name="@(isMyGallery ? "My Gallery" : "Gallery")" Icon="fas fa-images" />
  </div>
  <div class="col-sm-6 text-start text-sm-end">
    <AuthorizeView>
      <Authorized>
        @if (isMyGallery)
        {
          <a class="btn btn-secondary me-2" href="gallery">Public Gallery</a>
        }
        else
        {
          <a class="btn btn-secondary me-2" href="gallery/mine">My Gallery</a>
        }
        <button class="btn btn-primary" type="button" @onclick=@(() => AddEdit(null, -1))><i class="fas fa-plus"></i> Add New</button>
      </Authorized>
    </AuthorizeView>
  </div>
</div>

@if (Dtos == null)
{
  <BusyIndicator />
}
else
{
  <SmartishTable.Root SafeList="Dtos" @ref="smartishTable" HeaderTag="button">
    <div class="row">
      <div class="col-sm mb-2">
        <SmartishTable.FilterString Field="x=>x.Description" Context="filterContext" Operator="SmartishTable.Filters.StringOperators.Contains">
          <input type="text" @bind-value="@filterContext.FilterValue" @bind-value:event="oninput" name="Search" class="form-control form-control-sm" placeholder="Search Description..." />
        </SmartishTable.FilterString>
      </div>
      <div class="col-sm mb-2">
        <SmartishTable.Sort StartingSortDescending="true" Field="o=>o.AuditFieldsDto.CreatedDateTime" IsDefaultSort="true" Css="canSelect btn btn-outline-primary btn-sm">Sort By Upload Date</SmartishTable.Sort>
      </div>
    </div>
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 mb-2 g-2">
      <SmartishTable.Repeater Context="row">
        <RowTemplate>
          <div class="col">
            <div class="card h-100 bg-body-tertiary gallergy-card">
              @if (row.Item.IsVideoLink)
              {
                <iframe allowfullscreen src="@(row.Item.Document.DocumentFilename)" class="video-iframe card-img-top @(!isMyGallery && string.IsNullOrWhiteSpace(row.Item.Description) ? "card-img-bottom" :"")"></iframe>
              }
              else
              {
                      <Lightbox Source="@row.Item.GetPictureUrl()" ImgCSS="@(!isMyGallery && string.IsNullOrWhiteSpace(row.Item.Description) ? "card-img-bottom" :"")">
                      </Lightbox>
              }
              @if (isMyGallery)
              {
                <div class="card-body">
                  <button type="button" class="btn btn-sm btn-link" @onclick=@(() => AddEdit(row.Item, row.Index))>
                    <span class="fa fa-edit"></span>&nbsp;
                    @if (string.IsNullOrWhiteSpace(row.Item.Description))
                    {
                      <text>Edit</text>
                    }
                    else
                    {
                      @row.Item.Description
                    }
                  </button>
                </div>
              }
              else if (!string.IsNullOrWhiteSpace(row.Item.Description))
              {
                <div class="card-body">
                  @row.Item.Description
                </div>
              }
            </div>
          </div>
        </RowTemplate>
        <EmptyTemplate>
          @if (Dtos.Count == 0)
          {
            <div>Add a picture or YouTube link!!</div>
          }
          else
          {
            <div>Nothing found</div>
          }
        </EmptyTemplate>
      </SmartishTable.Repeater>
    </div>
    <SmartishTable.Pagination Context="Pager">
      <SmartishTablePager Paginator="Pager"></SmartishTablePager>
    </SmartishTable.Pagination>
  </SmartishTable.Root>
}

@inject IModalService modalService
@inject AuthorizedClient authClient
@inject AnonymousClient anonymousClient
@code {
  [Parameter]
  public string? GalleryType { get; set; }
  private SmartishTable.Root<PictureDto>? smartishTable;
  [PersistentState]
  public List<PictureDto>? Dtos { get; set; }

  private bool isMyGallery;

  private async Task AddEdit(PictureDto? dto, int index)
  {
    var isNew = dto == null;

    if (isNew)
    {
      dto = new PictureDto()
        {
          IsActive = true,
          IsUpdated = true,
          Document = new DocumentObjDto(),
          AuditFieldsDto = new AuditFieldsDto()
        };
    }
    var parameters = new Blazored.Modal.ModalParameters();
    parameters.Add(nameof(MediaAddEdit.DtoOriginal), dto!);
    var modalReference = modalService.Show<MediaAddEdit>("Media Add/Edit", parameters, new ModalOptions() { });
    var modalResult = await modalReference.Result;
    dto = modalResult.Data as PictureDto;
    if (dto != null && (dto.IsApproved || isMyGallery))
    {
      if (isNew)
        await smartishTable!.Add(dto);
      else
      {
        await smartishTable!.UpdateAt(index, dto);
      }
    }
  }

  protected override async Task OnParametersSetAsync()
  {
    isMyGallery = GalleryType == "mine";

      if (isMyGallery)
        Dtos = await authClient.GetMyMedia();
      else
        Dtos = await anonymousClient.GetPublicMedia();
  }
}