@page "/"
@using System.Web

<PageTitle>Michigan Team-1</PageTitle>

@if (pictures != null)
{
  <div class="main-carousel">
    @foreach (var pic in pictures)
    {
      <div class="carousel-cell">
        <a href="javascript:void(0)" @onclick="(() => ShowLightBox(pic.GetPictureUrl()))">
          <img data-flickity-lazyload="@pic.GetPictureUrl()" class="home-page-image" />
        </a>
      </div>
    }
  </div>
  @if (!string.IsNullOrWhiteSpace(lightBoxUrl))
  {
    <a href="javascript:void(0)" class="lightbox @show" @onclick=HideLightBox>
      <span style="background-image:url('@(lightBoxUrl)')" />
    </a>
  }
}

@if (announcements == null || events == null)
{
  <BusyIndicator />
}
else
{
  <div class="row">
    <div class="col-sm col-md-8 order-2 order-md-1">
      <h4>Announcements</h4>
      <SmartishTable.Root SafeList="announcements">
        <SmartishTable.Repeater Context="row">
          <RowTemplate>
            <div class="card mb-2">
              <h5 class="card-header">@row.Item.Title</h5>
              <div class="card-body">
                @((MarkupString)row.Item.Body)
              </div>
              <div class="card-footer">
                Posted On @row.Item.StartShowingOnDate.ToShortDateString() By @row.Item.AuditFieldsDto.CreatedByName
              </div>
            </div>
          </RowTemplate>
        </SmartishTable.Repeater>
        <SmartishTable.Pagination Context="Pager">
          <SmartishTablePager Paginator="Pager" HidePageSizer="true" DefaultPageSize="3"></SmartishTablePager>
        </SmartishTable.Pagination>
      </SmartishTable.Root>
    </div>
    <div class="col-sm col-md-4 order-1 order-md-2">
      <h4>Events</h4>
      @foreach (var item in events)
      {
        <div class="card mb-2">
          <h5 class="card-header">
            @item.Name
          </h5>
          <div class="card-body">
            <div class="card-text">
              <div>Date @item.EventDate.ToShortDateString()</div>
              @if (item.EventAlternateDate.HasValue)
              {
                <div>
                  Alternate Date @item.EventAlternateDate.Value.ToShortDateString()
                </div>
              }
              @for (int i = 0; i < item.Locations!.Count; i++)
              {
                @(i == 0 ? "At" : "Alternate") <a href="https://www.google.com/maps/search/?api=1&query=@BuildAddress(item.Locations[i])" class="btn btn-info btn-sm" target="_blank"><i class="fas fa-map-marked"></i> @item.Locations[i].LocationName <i class="fas fa-external-link-alt"></i></a>
                @if (!string.IsNullOrWhiteSpace(item.Locations[i].FAAWaiver))
                {
                  <div class="card-text">Altitude @item.Locations[i].FAAWaiver</div>
                }
              }
            </div>
          </div>
        </div>
      }
    </div>
  </div>
}

@implements IDisposable
@inject PersistentComponentState ApplicationState
@inject IModalService modalService
@inject AnonymousClient client
@inject IJSRuntime jsRuntime
@code {
  private PersistingComponentStateSubscription persistingSubscription;

  private List<AnnouncementDto>? announcements;
  private List<EventDto>? events;
  private List<PictureDto>? pictures;

  private string? lightBoxUrl;
  private string show = "";

  private static bool dragInProgress = false;

  protected override async Task OnInitializedAsync()
  {
    persistingSubscription = ApplicationState.RegisterOnPersisting(PersistData);

    if (!ApplicationState.TryTakeFromJson<List<AnnouncementDto>>(nameof(Home) + nameof(announcements), out var restored))
    {
      announcements = await client.GetAnnouncementsForHome();
    }
    else
    {
      announcements = restored!;
    }

    if (!ApplicationState.TryTakeFromJson<List<EventDto>>(nameof(Home) + nameof(events), out var restoredEvents))
    {
      events = await client.GetEventsForHome();
    }
    else
    {
      events = restoredEvents!;
    }

    if (!ApplicationState.TryTakeFromJson<List<PictureDto>>(nameof(Home) + nameof(pictures), out var restoredPictures))
    {
      pictures = await client.GetRandomPictures();
    }
    else
    {
      pictures = restoredPictures!;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (pictures?.Count > 0)
    {
      await jsRuntime.InvokeVoidAsync("carouselInit", ".main-carousel");
    }
  }

  private Task PersistData()
  {
    ApplicationState.PersistAsJson(nameof(Home) + nameof(announcements), announcements);
    ApplicationState.PersistAsJson(nameof(Home) + nameof(events), events);
    ApplicationState.PersistAsJson(nameof(Home) + nameof(pictures), pictures);

    return Task.CompletedTask;
  }

  private string? BuildAddress(LocationDto dto)
  {
    var address = dto!.AddressObj!.Address1;
    if (dto!.AddressObj!.Address2 != null)
      address += $" {dto!.AddressObj!.Address2}";
    if (dto!.AddressObj!.Address3 != null)
      address += $" {dto!.AddressObj!.Address3}";

    if (dto!.AddressObj!.City != null)
      address += $", {dto!.AddressObj!.City}";

    if (dto!.AddressObj!.GoverningDistrictName != null)
      address += $", {dto!.AddressObj!.GoverningDistrictName}";

    if (dto!.AddressObj!.PostalCode != null)
      address += $", {dto!.AddressObj!.PostalCode}";

    return HttpUtility.UrlEncode(address);
  }

  void IDisposable.Dispose()
  {
    persistingSubscription.Dispose();
  }

  [JSInvokable]
  public static Task DragStarted()
  {
    dragInProgress = true;
    return Task.CompletedTask;
  }

  [JSInvokable]
  public static Task Settled()
  {
    dragInProgress = false;
    return Task.CompletedTask;
  }

  private void ShowLightBox(string url)
  {
    if (dragInProgress) return;

    lightBoxUrl = url;
    show = "d-block";
    StateHasChanged();
  }

  private void HideLightBox()
  {
    lightBoxUrl = "";
    show = "";
    StateHasChanged();
  }
}