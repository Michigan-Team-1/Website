@page "/UserProfile"
@using Blazored.Toast.Services
@attribute [Authorize(Policy = nameof(PolicyNames.UserProfileEdit))]
<PageTitle>User Profile - Michigan Team-1</PageTitle>

@if (Dto == null)
{
  <div class="row mb-2">
    <div class="col-sm-6">
      <PageHeader Name="User Profile" Icon="fas fa-user" />
    </div>
  </div>
  <BusyIndicator />
}
else
{
  <EditForm EditContext="_editContext" OnValidSubmit="Save">
    <Blazored.FluentValidation.FluentValidationValidator />
    <div class="row mb-2">
      <div class="col-sm-4">
        <PageHeader Name="User Profile" Icon="fas fa-user" />
      </div>
      <div class="col-sm-4">
        <UnsavedChangesNotifcation Value="dataUpdated" />
      </div>
      <div class="col-sm-4 text-sm-start text-md-end">
        <button type="submit" class="btn btn-primary me-2" accesskey="S"><i class="far fa-save"></i> Save</button>
      </div>
    </div>
    <EditUserDetails Dto="Dto" MobileCarriers="mobileCarriers" Updated="ChildUpdated" DtoOriginal="DtoOriginal" Countries="countries" GoverningDistricts="governingDistricts" OnPage=Helpers.PageEnum.UserProfile />
    <div class="modal-footer">
      <div class="col"><UnsavedChangesNotifcation Value="dataUpdated" /></div>
      <div class="col text-end">
        <button type="submit" class="btn btn-primary me-2" accesskey="S"><i class="far fa-save"></i> Save</button>
      </div>
    </div>
  </EditForm>
}

@inject AuthorizedClient client
@inject AnonymousClient anonClient
@inject IToastService toastService;
@code {
  [PersistentState]
  public UserDto? DtoOriginal { get; set; } = default!;

  private UserDto Dto { get; set; } = default!;

  [PersistentState]
  public List<SelectOptionDto<int>>? mobileCarriers{ get; set; }
  [PersistentState]
  public List<CountryDto>? countries{ get; set; }
  [PersistentState]
  public List<GoverningDistrictDto>? governingDistricts{ get; set; }

  private EditContext _editContext = default!;

  private bool dataUpdated
  {
    get
    {
      return !Dto.Equals(DtoOriginal);
    }
  }

  protected override async Task OnInitializedAsync()
  {
    DtoOriginal = await client.GetUserProfile();

    if (DtoOriginal == null)
      return;

    mobileCarriers = await anonClient.GetMobileCarriers(); ;
    countries = await anonClient.GetCountries();
    governingDistricts = await anonClient.GetGoverningDistricts();

    Dto = DtoOriginal.SerializeJson().DeserializeJson<UserDto>()!;
    _editContext = new EditContext(Dto);
  }

  async Task Save()
  {
    Dto.IsUpdated = dataUpdated;
    if (Dto.IsUpdated)
    {
      var data = await client.SaveUserProfile(Dto);
      if (data != null)
      {
        toastService.ShowSuccess("Save successful!");
        DtoOriginal = data;
        Dto = DtoOriginal.SerializeJson().DeserializeJson<UserDto>()!;
        _editContext = new EditContext(Dto);
      }
    }
  }

  private void ChildUpdated()
  {
    StateHasChanged();
  }
}
