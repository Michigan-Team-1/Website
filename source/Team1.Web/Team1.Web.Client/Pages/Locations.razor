@page "/locations"
@attribute [Authorize(Policy = nameof(PolicyNames.LocationAddEditDelete))]
<PageTitle>Locations - Michigan Team-1</PageTitle>

<div class="row mb-2">
  <div class="col-sm-6">
    <PageHeader Name="Locations" Icon="fas fa-map-marked-alt" />
  </div>
  <div class="col-sm-6 text-sm-start text-md-end">
      <button class="btn btn-primary" type="button" @onclick=@(() => AddEdit(null, -1))><i class="fas fa-plus">&nbsp;</i> Add New</button>
  </div>
</div>
@if (Dtos == null)
{
  <BusyIndicator />
}
else
{
  <SmartishTable.Root SafeList="Dtos" @ref="smartishTable">
    <table class="table table-condensed table-hover table-striped">
      <thead>
        <tr>
          <SmartishTable.Sort Field="o=>o.LocationName" IsDefaultSort="true" Css="canSelect">@PropertyReflections.GetLabelName(PropertyReflections.LocationDtoProperties, nameof(LocationDto.LocationName))</SmartishTable.Sort>
            <SmartishTable.Sort Field="o=>o.FAAWaiver" Css="canSelect">@PropertyReflections.GetLabelName(PropertyReflections.LocationDtoProperties, nameof(LocationDto.FAAWaiver))</SmartishTable.Sort>
            <SmartishTable.Sort Field="o=>o.AuditFieldsDto.CreatedDate" Css="canSelect">@PropertyReflections.GetLabelName(PropertyReflections.AuditFieldsDtoProperties, nameof(LocationDto.AuditFieldsDto.CreatedDate))</SmartishTable.Sort>
            <SmartishTable.Sort Field="o=>o.AuditFieldsDto.CreatedByName" Css="canSelect">@PropertyReflections.GetLabelName(PropertyReflections.AuditFieldsDtoProperties, nameof(LocationDto.AuditFieldsDto.CreatedByName))</SmartishTable.Sort>
            <SmartishTable.Sort Field="o=>o.IsActive" Css="canSelect">@PropertyReflections.GetLabelName(PropertyReflections.LocationDtoProperties, nameof(LocationDto.IsActive))</SmartishTable.Sort>
          </tr>
          <tr>
            <td>
              <select @bind="stringOperators[nameof(LocationDto.LocationName)]" class="form-select form-select-sm">
                @foreach (var item in SmartishTable.Filters.StringOperators.Equals.GetList())
              {
                <option value="@item">@item.GetDisplayName()</option>
              }
            </select>
            <SmartishTable.FilterString SmartishTItem="LocationDto" Field="x=>x.LocationName" Context="filterContext" Operator="stringOperators[nameof(LocationDto.LocationName)]">
              <input type="text" @bind-value="@filterContext.FilterValue" @bind-value:event="oninput" name="Search" class="form-control form-control-sm" />
            </SmartishTable.FilterString>
          </td>
          <td>
            <select @bind="stringOperators[nameof(LocationDto.FAAWaiver)]" class="form-select form-select-sm">
              @foreach (var item in SmartishTable.Filters.StringOperators.Equals.GetList())
              {
                <option value="@item">@item.GetDisplayName()</option>
              }
            </select>
            <SmartishTable.FilterString SmartishTItem="LocationDto" Field="x=>x.FAAWaiver" Context="filterContext" Operator="stringOperators[nameof(LocationDto.FAAWaiver)]">
              <input type="text" @bind-value="@filterContext.FilterValue" @bind-value:event="oninput" name="Search" class="form-control form-control-sm" />
            </SmartishTable.FilterString>
          </td>
          <td>
            <select @bind="createdDateTimeOperator" class="form-select form-select-sm">
              @foreach (var item in SmartishTable.Filters.DateTimeOperators.Equals.GetList())
              {
                <option value="@item">@item.GetDisplayName()</option>
              }
            </select>
            <SmartishTable.FilterDatesTimes SmartishTItem="LocationDto" Field="x=>x.AuditFieldsDto.CreatedDate" Context="filterContext" Operator="createdDateTimeOperator" FilterType="DateOnly?">
              <input type="date" @bind-value="@filterContext.FilterValue" @bind-value:event="oninput" name="Search" class="form-control form-control-sm" />
            </SmartishTable.FilterDatesTimes>
          </td>
          <td>
            <select @bind="createdByNameOperator" class="form-select form-select-sm">
              @foreach (var item in SmartishTable.Filters.StringOperators.Equals.GetList())
              {
                <option value="@item">@item.GetDisplayName()</option>
              }
            </select>
            <SmartishTable.FilterString SmartishTItem="LocationDto" Field="x=>x.AuditFieldsDto.CreatedByName" Context="filterContext" Operator="createdByNameOperator">
              <input type="text" @bind-value="@filterContext.FilterValue" @bind-value:event="oninput" name="Search" class="form-control form-control-sm" />
            </SmartishTable.FilterString>
          </td>
          <td>
            <select @bind="activeOperator" class="form-select form-select-sm">
              <option value="@SmartishTable.Filters.BooleanOperators.Equals">All</option>
              @foreach (var item in SmartishTable.Filters.BooleanOperators.Equals.GetList().Where(w => ((byte)w) > 8))
              {
                <option selected="@(activeOperator == item)" value="@item">@(item == SmartishTable.Filters.BooleanOperators.IsTrue ? "Yes" : "No")</option>
              }
            </select>
            <SmartishTable.FilterBoolean Field="o=>o.IsActive" Operator="activeOperator"></SmartishTable.FilterBoolean>
          </td>
        </tr>
      </thead>
      <tbody>
        <SmartishTable.Repeater Context="row">
          <RowTemplate>
            <tr class="align-middle">
              <td>
                <button class="btn btn-link btn-sm" type="button" @onclick=@(() => AddEdit(row.Item, row.Index))>
                  <span class="fa fa-edit"></span>
                  @row.Item.LocationName
                </button>
              </td>
              <td>@row.Item.FAAWaiver</td>
              <td class="text-center">@row.Item.AuditFieldsDto.CreatedDate?.ToShortDateString()</td>
              <td>@row.Item.AuditFieldsDto.CreatedByName</td>
              <td class="text-center">
                <IsActive Value="@row.Item.IsActive" />
              </td>
            </tr>
          </RowTemplate>
          <EmptyTemplate>
            <tr>
              <td colspan="5">
                <EmptyDataRow />
              </td>
            </tr>
          </EmptyTemplate>
        </SmartishTable.Repeater>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="5">
            <SmartishTable.Pagination Context="Pager">
              <SmartishTablePager Paginator="Pager"></SmartishTablePager>
            </SmartishTable.Pagination>
          </td>
        </tr>
      </tfoot>
    </table>
  </SmartishTable.Root>
}

@inject IModalService modalService
@inject AuthorizedClient authClient
@inject AnonymousClient client
@code {
  private SmartishTable.Root<LocationDto>? smartishTable;

  [PersistentState]
  public List<LocationDto>? Dtos{ get; set; }

  private List<CountryDto>? countries;
  private List<GoverningDistrictDto>? governingDistricts;

  private Dictionary<string, SmartishTable.Filters.StringOperators> stringOperators = default!;
  private SmartishTable.Filters.DateTimeOperators createdDateTimeOperator = SmartishTable.Filters.DateTimeOperators.GreaterThan;
  private SmartishTable.Filters.StringOperators createdByNameOperator = SmartishTable.Filters.StringOperators.Contains;
  private SmartishTable.Filters.BooleanOperators? activeOperator = SmartishTable.Filters.BooleanOperators.IsTrue;

  protected override async Task OnInitializedAsync()
  {
    stringOperators = PropertyReflections.LocationDtoProperties.GetStringOperatorsForTypeProperties();
    Dtos = await authClient.GetLocations();
  }

  private async Task AddEdit(LocationDto? dto, int index)
  {
    var isNew = dto == null;

    if (countries == null)
    {
      var countriesTask = client.GetCountries();
      var governingDistrictsTask = client.GetGoverningDistricts();

      await Task.WhenAll(countriesTask, governingDistrictsTask);
      countries = countriesTask.Result;
      governingDistricts = governingDistrictsTask.Result;
    }
    if (isNew)
    {
      var country = countries!.First(w => w.CountryId == 840);
      dto = new LocationDto()
        {
          IsActive = true,
          IsUpdated = true,
          AddressObj = new AddressObjDto()
          {
            CountryId = country.CountryId,
            GoverningDistrictName = country.GoverningDistrictName,
            GoverningDistrictId = 27,
            PostalCodeMask = country.PostalCodeMask,
          },
          AuditFieldsDto = new AuditFieldsDto()
        };
    }
    var parameters = new Blazored.Modal.ModalParameters();
    parameters.Add(nameof(LocationAddEdit.DtoOriginal), dto!);
    parameters.Add(nameof(LocationAddEdit.Countries), countries!);
    parameters.Add(nameof(LocationAddEdit.GoverningDistricts), governingDistricts!);
    var modalReference = modalService.Show<LocationAddEdit>("Location Add/Edit", parameters, new ModalOptions() { });
    var modalResult = await modalReference.Result;
    dto = modalResult.Data as LocationDto;
    if (dto != null)
    {
      if (isNew)
        await smartishTable!.Add(dto);
      else
        await smartishTable!.UpdateAt(index, dto);
    }
  }
}
