<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <aspNetCore xdt:Transform="Replace" processPath=".\Team1.web.site.exe"  stdoutLogEnabled="false" stdoutLogFile="..\uploads\stdout" hostingModel="InProcess">
        <environmentVariables xdt:Transform="Remove">
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>